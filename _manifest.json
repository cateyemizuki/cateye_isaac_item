{
  "manifest_version": 2,
  "id": "github.cateye.isaac.item",
  "version": "0.2.5",
  "name": "以撒道具图鉴",
  "description": "《以撒的结合》道具图鉴与存档解析插件：既能按中文名、英文名、编号、标签或效果关键词查询道具的品质、效果与协同（数据为打包在插件内的离线快照），也能让用户把游戏存档 .dat 传到群文件后由插件按 QQ 号缓存并解析出进度解析图、成就 / 图鉴 / 挑战完成度与全局统计（全程只读，不修改存档）。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_isaac_item",
    "homepage": "https://github.com/cateyemizuki/cateye_isaac_item",
    "documentation": "https://github.com/cateyemizuki/cateye_isaac_item/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_isaac_item/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "gamepad-2",
      "fallback": "package"
    }
  },
  "changelog": "CHANGELOG.md"
}
